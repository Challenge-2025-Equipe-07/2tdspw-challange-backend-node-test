DATABASE_URL="postgresql://veti:veti@localhost:5432/veti?schema=public"
PORT=3003

# Firebase Admin — used to verify ID tokens from the mobile app.
# FIREBASE_SERVICE_ACCOUNT is optional JSON for a service account.
FIREBASE_PROJECT_ID=""
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'

# Local-only: accept requests with no Bearer token as AUTH_DEV_USER_ID / SEED_USER_ID.
# Ignored in production. A presented Bearer token is always verified (never mapped to the demo user).
# Seed demo tutors/pets stay on seed-vet-demo. Each Firebase uid is an empty clinic until that vet creates data.
AUTH_DEV_BYPASS=true
SEED_USER_ID="seed-vet-demo"
AUTH_DEV_USER_ID="seed-vet-demo"

# Shared secret for POST /notifications/chat. The caller sends it as x-chat-webhook-secret.
CHAT_WEBHOOK_SECRET=""

# Tutor Web Push. Generate a pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: URL. Do not commit the private key.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
